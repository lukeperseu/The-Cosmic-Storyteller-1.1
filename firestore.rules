rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ChatGlobal/{msgId} {
      allow read, write: if true;
    }

    match /CampanhasGlobais/{campId} {
      allow read, write: if true;
    }

    match /CampanhasGlobaisMsgs/{msgId} {
      allow read, write: if true;
    }

    match /UserProfiles/{userId} {
      allow read, write: if true;
    }

    match /Campanhas/{campanhaId} {
      allow read: if true;
      allow write: if request.auth != null || resource.data.userId == "public" || request.resource.data.userId == "public";
    }

    match /Feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /RecomendacoesZane/{recomendacaoId} {
      allow create: if true;
      allow read, write: if true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

